<form id="contacto-form" class="flex flex-col gap-5">
  <div class="contacto-field grid grid-cols-2 gap-5">
    <div class="flex flex-col gap-2">
      <label
        class="text-xs tracking-widest uppercase text-neutral-900/60"
        for="nombre"
      >
        Nombre
      </label>
      <input
        id="nombre"
        name="nombre"
        type="text"
        required
        class="bg-transparent border-b border-neutral-50 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-50/70 transition-colors font-light"
        placeholder="Tu nombre"
      />
    </div>
    <div class="flex flex-col gap-2">
      <label
        class="text-xs tracking-widest uppercase text-neutral-900/60"
        for="apellido"
      >
        Apellido
      </label>
      <input
        id="apellido"
        name="apellido"
        type="text"
        required
        class="bg-transparent border-b border-neutral-50 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-50/70 transition-colors font-light"
        placeholder="Tu apellido"
      />
    </div>
  </div>

  <div class="contacto-field flex flex-col gap-2">
    <label
      class="text-xs tracking-widest uppercase text-neutral-900/60"
      for="email"
    >
      Email
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      class="bg-transparent border-b border-neutral-50 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-50/70 transition-colors font-light"
      placeholder="tu@email.com"
    />
  </div>

  <div class="contacto-field flex flex-col gap-2">
    <label
      class="text-xs tracking-widest uppercase text-neutral-900/60"
      for="mensaje"
    >
      Mensaje
    </label>
    <textarea
      id="mensaje"
      name="mensaje"
      rows="5"
      required
      class="bg-transparent border-b border-neutral-50 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-50/70 transition-colors resize-none font-light"
      placeholder="Contanos sobre tu proyecto o desafío..."></textarea>
  </div>

  <div id="contacto-submit" class="flex flex-col items-end gap-3 mt-2">
    <p id="contacto-status" class="text-xs text-neutral-900" role="status" hidden></p>
    <button
      type="submit"
      class="inline-flex cursor-pointer items-center gap-3 border border-neutral-950 text-neutral-50 text-xs tracking-widest uppercase px-8 py-4 hover:bg-neutral-50 hover:border-neutral-950 hover:text-neutral-950 bg-neutral-950 transition-colors rounded-full disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span id="contacto-submit-label">Enviar mensaje</span>
      <span class="text-base">→</span>
    </button>
  </div>
</form>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";
  import type { ContactoApiResponse } from "../types/contacto.ts";

  const form = document.getElementById("contacto-form") as HTMLFormElement;
  const formFields = document.querySelectorAll(".contacto-field");
  const submitEl = document.getElementById("contacto-submit")!;
  const submitButton = form.querySelector("button[type='submit']")!;
  const submitLabel = document.getElementById("contacto-submit-label")!;
  const statusEl = document.getElementById("contacto-status")!;

  const formTl = gsap.timeline({ paused: true });
  formTl
    .from(formFields, { opacity: 0, y: 30, stagger: 0.2, ease: "none" })
    .from(submitEl, { opacity: 0, filter: "blur(4px)", ease: "none" }, "-=0.1");

  ScrollTrigger.create({
    trigger: form,
    start: "top 85%",
    end: "bottom 85%",
    animation: formTl,
    scrub: true,
  });

  function setStatus(message: string, isError: boolean) {
    statusEl.textContent = message;
    statusEl.hidden = false;
    statusEl.classList.toggle("text-red-700", isError);
    statusEl.classList.toggle("text-neutral-900", !isError);
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(form);
    const payload = {
      nombre: String(formData.get("nombre") ?? "").trim(),
      apellido: String(formData.get("apellido") ?? "").trim(),
      email: String(formData.get("email") ?? "").trim(),
      mensaje: String(formData.get("mensaje") ?? "").trim(),
    };

    submitButton.setAttribute("disabled", "true");
    submitLabel.textContent = "Enviando...";
    statusEl.hidden = true;

    try {
      const response = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const result: ContactoApiResponse = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(result.error ?? "send_failed");
      }

      setStatus("¡Gracias! Te vamos a responder a la brevedad.", false);
      form.reset();
    } catch {
      setStatus(
        "No pudimos enviar tu mensaje. Probá de nuevo o escribinos a hola@umbralcomunicacion.com.ar.",
        true,
      );
    } finally {
      submitButton.removeAttribute("disabled");
      submitLabel.textContent = "Enviar mensaje";
    }
  });
</script>
