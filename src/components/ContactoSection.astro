---
---

<section
  id="contacto"
  class="px-10 py-24"
  style="background: linear-gradient(to right, #9A9090 0%, #909098 50%, #8090A0 100%);"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-16 xl:gap-24">
      <!-- Left: Contact info -->
      <div class="flex flex-col justify-between">
        <div>
          <p id="contacto-label" class="text-xs tracking-[0.3em] uppercase text-[#E2D9CF]/60 mb-3 font-light">
            Escribinos
          </p>
          <h2
            id="contacto-title"
            class="text-6xl xl:text-7xl font-light italic text-[#E2D9CF] mb-10"
            style="font-family: var(--font-heading);"
          >
            Hablemos
          </h2>
          <p id="contacto-desc" class="text-sm text-[#E2D9CF]/70 leading-relaxed max-w-xs font-light">
            Si estás pensando en un proceso de transformación o querés entender mejor cómo trabajamos, nos encantaría escucharte.
          </p>
        </div>

        <div id="contacto-links" class="flex flex-col gap-4 mt-12">
          <a
            href="mailto:hola@umbral.com.ar"
            class="flex items-center gap-3 text-sm text-[#E2D9CF]/80 hover:text-[#E2D9CF] transition-colors font-light"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            hola@umbral.com.ar
          </a>

          <a
            href="https://www.linkedin.com/company/umbral"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-sm text-[#E2D9CF]/80 hover:text-[#E2D9CF] transition-colors font-light"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>

          <p class="flex items-center gap-3 text-sm text-[#E2D9CF]/60 font-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Buenos Aires, Argentina
          </p>
        </div>
      </div>

      <!-- Right: Contact form -->
      <form id="contacto-form" class="flex flex-col gap-5">
        <div class="contacto-field grid grid-cols-2 gap-5">
          <div class="flex flex-col gap-2">
            <label class="text-xs tracking-widest uppercase text-[#E2D9CF]/60 font-light" for="nombre">
              Nombre
            </label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              class="bg-transparent border-b border-[#E2D9CF]/30 py-2 text-sm text-[#E2D9CF] placeholder-[#E2D9CF]/30 focus:outline-none focus:border-[#E2D9CF]/70 transition-colors font-light"
              placeholder="Tu nombre"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-xs tracking-widest uppercase text-[#E2D9CF]/60 font-light" for="apellido">
              Apellido
            </label>
            <input
              id="apellido"
              name="apellido"
              type="text"
              class="bg-transparent border-b border-[#E2D9CF]/30 py-2 text-sm text-[#E2D9CF] placeholder-[#E2D9CF]/30 focus:outline-none focus:border-[#E2D9CF]/70 transition-colors font-light"
              placeholder="Tu apellido"
            />
          </div>
        </div>

        <div class="contacto-field flex flex-col gap-2">
          <label class="text-xs tracking-widest uppercase text-[#E2D9CF]/60 font-light" for="email">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            class="bg-transparent border-b border-[#E2D9CF]/30 py-2 text-sm text-[#E2D9CF] placeholder-[#E2D9CF]/30 focus:outline-none focus:border-[#E2D9CF]/70 transition-colors font-light"
            placeholder="tu@email.com"
          />
        </div>

        <div class="contacto-field flex flex-col gap-2">
          <label class="text-xs tracking-widest uppercase text-[#E2D9CF]/60 font-light" for="mensaje">
            Mensaje
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            class="bg-transparent border-b border-[#E2D9CF]/30 py-2 text-sm text-[#E2D9CF] placeholder-[#E2D9CF]/30 focus:outline-none focus:border-[#E2D9CF]/70 transition-colors resize-none font-light"
            placeholder="Contanos sobre tu proyecto o desafío..."
          ></textarea>
        </div>

        <div id="contacto-submit" class="flex justify-end mt-2">
          <button
            type="submit"
            class="inline-flex items-center gap-3 border border-[#E2D9CF] text-[#E2D9CF] text-xs tracking-widest uppercase px-8 py-4 hover:bg-[#E2D9CF] hover:text-[#5A4E46] transition-colors"
          >
            Enviar mensaje
            <span class="text-base">→</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  const section = document.getElementById("contacto")!;
  const labelEl = document.getElementById("contacto-label")!;
  const titleEl = document.getElementById("contacto-title")!;
  const descEl = document.getElementById("contacto-desc")!;
  const linksEl = document.getElementById("contacto-links")!;
  const formFields = document.querySelectorAll(".contacto-field");
  const submitEl = document.getElementById("contacto-submit")!;

  // — Columna izquierda: label + SplitText en h2 —
  const split = new SplitText(titleEl, { type: "chars" });

  const leftTl = gsap.timeline({ paused: true });
  leftTl
    .from(labelEl, { opacity: 0, filter: "blur(6px)", ease: "none" })
    .from(
      split.chars,
      { opacity: 0, filter: "blur(8px)", stagger: 0.05, ease: "none" },
      "-=0.3",
    )
    .from(descEl, { opacity: 0, filter: "blur(6px)", ease: "none" }, "-=0.2")
    .from(
      linksEl.children,
      { opacity: 0, y: 16, stagger: 0.12, ease: "none" },
      "-=0.2",
    );

  ScrollTrigger.create({
    trigger: section,
    start: "top 80%",
    end: "center 55%",
    animation: leftTl,
    scrub: true,
  });

  // — Formulario: campos con stagger + botón —
  const formTl = gsap.timeline({ paused: true });
  formTl
    .from(formFields, { opacity: 0, y: 30, stagger: 0.2, ease: "none" })
    .from(submitEl, { opacity: 0, filter: "blur(4px)", ease: "none" }, "-=0.1");

  ScrollTrigger.create({
    trigger: document.getElementById("contacto-form")!,
    start: "top 85%",
    end: "bottom 70%",
    animation: formTl,
    scrub: true,
  });
</script>
