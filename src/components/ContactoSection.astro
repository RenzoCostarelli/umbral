---
import type { HomepageContacto } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";

interface Props {
  title: HomepageContacto["title"];
  text: HomepageContacto["text"];
  data: HomepageContacto["data"];
}

const { title, text, data } = Astro.props;
---

<section
  id="contacto"
  class="px-10 py-24"
  style="background: linear-gradient(to right, #9A9090 0%, #909098 50%, #8090A0 100%);"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-16 xl:gap-24">
      <div class="flex flex-col gap-6 justify-between">
        <div>
          <h2
            id="contacto-title"
            class="md:text-[1.3125rem] font-light font-serif italic text-neutral-800 mb-10"
          >
            {title}
          </h2>
          <div id="contacto-text" class="text-neutral-900 text-balance">
            <PrismicRichText field={text} />
          </div>
        </div>

        {
          data.length > 0 && (
            <div id="contacto-data" class="flex flex-col gap-6 mt-12">
              {data.map((item) => (
                <div class="contacto-data-item flex flex-col gap-1">
                  <p class="font-semibold text-neutral-900 font-serif">
                    {item.name}
                  </p>
                  {item.position && (
                    <p class="text-xs text-neutral-900">{item.position}</p>
                  )}
                  {item.phone && (
                    <a
                      href={`https://wa.me/${item.phone.replace(/\D/g, "")}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-neutral-900 hover:text-neutral-900 transition-colors"
                    >
                      WhatsApp {item.phone}
                    </a>
                  )}
                </div>
              ))}
            </div>
          )
        }
      </div>

      <form id="contacto-form" class="flex flex-col gap-5">
        <div class="contacto-field grid grid-cols-2 gap-5">
          <div class="flex flex-col gap-2">
            <label
              class="text-xs tracking-widest uppercase text-neutral-900/60"
              for="nombre"
            >
              Nombre
            </label>
            <input
              id="nombre"
              name="nombre"
              type="text"
              class="bg-transparent border-b border-neutral-800 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-800/70 transition-colors font-light"
              placeholder="Tu nombre"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              class="text-xs tracking-widest uppercase text-neutral-900/60"
              for="apellido"
            >
              Apellido
            </label>
            <input
              id="apellido"
              name="apellido"
              type="text"
              class="bg-transparent border-b border-neutral-800 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-800/70 transition-colors font-light"
              placeholder="Tu apellido"
            />
          </div>
        </div>

        <div class="contacto-field flex flex-col gap-2">
          <label
            class="text-xs tracking-widest uppercase text-neutral-900/60"
            for="email"
          >
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            class="bg-transparent border-b border-neutral-800 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-800/70 transition-colors font-light"
            placeholder="tu@email.com"
          />
        </div>

        <div class="contacto-field flex flex-col gap-2">
          <label
            class="text-xs tracking-widest uppercase text-neutral-900/60"
            for="mensaje"
          >
            Mensaje
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            class="bg-transparent border-b border-neutral-800 py-2 text-sm text-neutral-900 placeholder-neutral-800 focus:outline-none focus:border-neutral-800/70 transition-colors resize-none font-light"
            placeholder="Contanos sobre tu proyecto o desafío..."></textarea>
        </div>

        <div id="contacto-submit" class="flex justify-end mt-2">
          <button
            type="submit"
            class="inline-flex cursor-pointer items-center gap-3 border border-neutral-950 text-neutral-50 text-xs tracking-widest uppercase px-8 py-4 hover:bg-neutral-50 hover:border-neutral-950 hover:text-neutral-950 bg-neutral-950 transition-colors rounded-full"
          >
            Enviar mensaje
            <span class="text-base">→</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  const section = document.getElementById("contacto")!;
  const titleEl = document.getElementById("contacto-title")!;
  const textEl = document.getElementById("contacto-text")!;
  const dataEl = document.getElementById("contacto-data");
  const formFields = document.querySelectorAll(".contacto-field");
  const submitEl = document.getElementById("contacto-submit")!;

  // — Columna izquierda: SplitText en h2 + texto + datos —
  const split = new SplitText(titleEl, { type: "chars" });

  const leftTl = gsap.timeline({ paused: true });
  leftTl
    .from(split.chars, {
      opacity: 0,
      filter: "blur(8px)",
      stagger: 0.05,
      ease: "none",
    })
    .from(textEl, { opacity: 0, filter: "blur(6px)", ease: "none" }, "-=0.2");

  if (dataEl) {
    leftTl.from(
      dataEl.querySelectorAll(".contacto-data-item"),
      { opacity: 0, y: 16, stagger: 0.12, ease: "none" },
      "-=0.2",
    );
  }

  ScrollTrigger.create({
    trigger: section,
    start: "top 80%",
    end: "center 75%",
    animation: leftTl,
    scrub: true,
  });

  const formTl = gsap.timeline({ paused: true });
  formTl
    .from(formFields, { opacity: 0, y: 30, stagger: 0.2, ease: "none" })
    .from(submitEl, { opacity: 0, filter: "blur(4px)", ease: "none" }, "-=0.1");

  ScrollTrigger.create({
    trigger: document.getElementById("contacto-form")!,
    start: "top 85%",
    end: "bottom 85%",
    animation: formTl,
    scrub: true,
  });
</script>
