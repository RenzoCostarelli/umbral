---
import type { HomepageContacto } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";
import ContactoForm from "./ContactoForm.astro";

interface Props {
  title: HomepageContacto["title"];
  text: HomepageContacto["text"];
  data: HomepageContacto["data"];
}

const { title, text, data } = Astro.props;
---

<section
  id="contacto"
  class="px-10 py-24"
  style="background: linear-gradient(to right, #9A9090 0%, #909098 50%, #8090A0 100%);"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-16 xl:gap-24">
      <div class="flex flex-col gap-6 justify-between">
        <div>
          <h2
            id="contacto-title"
            class="text-[1.75rem] font-light font-serif italic text-neutral-800 mb-10"
          >
            {title}
          </h2>
          <div id="contacto-text" class="text-neutral-900 text-balance">
            <PrismicRichText field={text} />
          </div>
        </div>

        {
          data.length > 0 && (
            <div id="contacto-data" class="flex flex-col gap-6 mt-12">
              {data.map((item) => (
                <div class="contacto-data-item flex flex-col gap-1">
                  <p class="font-semibold text-neutral-900 font-serif">
                    {item.name}
                  </p>
                  {item.position && (
                    <p class="md:text-xs text-neutral-900">{item.position}</p>
                  )}
                  {item.phone && (
                    <a
                      href={`https://wa.me/${item.phone.replace(/\D/g, "")}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="md:text-xs text-neutral-900 hover:text-neutral-900 transition-colors"
                    >
                      WhatsApp {item.phone}
                    </a>
                  )}
                </div>
              ))}
            </div>
          )
        }
      </div>

      <ContactoForm />
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  const section = document.getElementById("contacto")!;
  const titleEl = document.getElementById("contacto-title")!;
  const textEl = document.getElementById("contacto-text")!;
  const dataEl = document.getElementById("contacto-data");

  // — Columna izquierda: SplitText en h2 + texto + datos —
  const split = new SplitText(titleEl, { type: "chars" });

  const leftTl = gsap.timeline({ paused: true });
  leftTl
    .from(split.chars, {
      opacity: 0,
      filter: "blur(8px)",
      stagger: 0.05,
      ease: "none",
    })
    .from(textEl, { opacity: 0, filter: "blur(6px)", ease: "none" }, "-=0.2");

  if (dataEl) {
    leftTl.from(
      dataEl.querySelectorAll(".contacto-data-item"),
      { opacity: 0, y: 16, stagger: 0.12, ease: "none" },
      "-=0.2",
    );
  }

  ScrollTrigger.create({
    trigger: section,
    start: "top 80%",
    end: "center 75%",
    animation: leftTl,
    scrub: true,
  });
</script>
