---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Somos", href: "/#somos" },
  { label: "Hacemos", href: "/#hacemos" },
  { label: "Diferenciales", href: "/#diferenciales" },
  { label: "Contacto", href: "/#contacto" },
];
---

<footer class="bg-[#C2CDD6] w-full">
  <div class="flex items-center justify-between px-10 py-8">
    <!-- Logo -->
    <a href="/" class="flex flex-col gap-1">
      <span
        class="text-xl font-bold tracking-[0.25em] text-[#1E1816] uppercase"
        style="font-family: var(--font-heading);"
      >
        UMBRAL
      </span>
      <span
        class="text-[0.6rem] tracking-widest text-[#3A3028] uppercase font-light"
      >
        Consultora en comunicación, cultura y marca.
      </span>
    </a>

    <!-- Nav links -->
    <div class="hidden md:flex items-center gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-xs text-[#1E1816] tracking-widest uppercase hover:opacity-60 transition-opacity"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Social -->
    <div class="flex flex-col items-end gap-2">
      <span class="text-xs tracking-widest uppercase text-[#1E1816]"
        >Seguinos!</span
      >
      <a
        href="https://www.linkedin.com/company/umbral"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-[#1E1816] hover:opacity-60 transition-opacity"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="border-t border-[#A8B8C2] px-10 py-4">
    <p class="text-[0.65rem] text-[#3A3028] tracking-wide">
      © {new Date().getFullYear()} Umbral. Todos los derechos reservados.
    </p>
  </div>
</footer>
