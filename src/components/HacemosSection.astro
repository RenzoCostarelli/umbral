---
import type { RichTextField } from "@prismicio/client";
import type { HomepageHacemosItem } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";
import TresIcon from "./ui/icons/tresIcon.astro";

interface Props {
  label: string;
  title: string;
  subtitle: string;
  items: HomepageHacemosItem[];
  endText: RichTextField;
}

const { label, title, subtitle, items, endText } = Astro.props;
---

<section id="hacemos" class="relative overflow-hidden px-10 py-24 bg-[#678894]">
  <div class="absolute w-80 right-0 top-10 text-neutral-50 opacity-10">
    <TresIcon />
  </div>
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="space-y-2">
      <p
        id="hacemos-label"
        class="text-xs tracking-[0.3em] uppercase text-neutral-900 mb-5"
      >
        {label}
      </p>
      <p id="hacemos-title" class="text-neutral-900 md:text-[1.25rem]">
        {title}
      </p>
      <h3 id="hacemos-subtitle" class="text-3xl text-neutral-900 font-serif">
        {subtitle}
      </h3>
    </div>
    <div
      id="hacemos-items"
      class="flex flex-col gap-0 divide-[#6A7E86]/40 max-w-xl pt-14"
    >
      {
        items.map((item) => (
          <div class="hacemos-item mb-4">
            <div class="flex items-center gap-2 mb-3">
              <div class="h-2 w-2 rounded-full bg-white" />
              <h3 class="text-2xl uppercase font-serif text-neutral-100 font-bold">
                {item.titulo}
              </h3>
            </div>
            <PrismicRichText
              field={item.description}
              class="md:text-xl [&_p]:leading-relaxed [&_p]:text-neutral-90"
            />
          </div>
        ))
      }
    </div>

    <div id="hacemos-end" class="mt-16">
      <PrismicRichText
        field={endText}
        class="text-neutral-100 leading-none [&_p]:md:text-[1.3125rem] [&_p]:font-light [&_p]:font-serif [&_p+p]:mt-2 [&_em]:italic"
      />
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  const labelEl = document.getElementById("hacemos-label")!;
  const titleEl = document.getElementById("hacemos-title")!;
  const subtitleEl = document.getElementById("hacemos-subtitle")!;
  const itemsEl = document.getElementById("hacemos-items")!;
  const items = document.querySelectorAll(".hacemos-item");
  const endEl = document.getElementById("hacemos-end")!;

  // Label + título — blur simple
  const headerTl = gsap.timeline({ paused: true });
  headerTl.from([labelEl, titleEl], {
    opacity: 0,
    filter: "blur(6px)",
    stagger: 0.2,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: labelEl,
    start: "top 90%",
    end: "top 55%",
    animation: headerTl,
    scrub: true,
  });

  // Subtítulo h3 — SplitText blur por palabras
  const split = new SplitText(subtitleEl, { type: "words" });

  const subtitleTl = gsap.timeline({ paused: true });
  subtitleTl.from(split.words, {
    opacity: 0,
    filter: "blur(8px)",
    stagger: 0.1,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: subtitleEl,
    start: "top 85%",
    end: "top 45%",
    animation: subtitleTl,
    scrub: true,
  });

  // Items — opacity + translateY con stagger
  const itemsTl = gsap.timeline({ paused: true });
  itemsTl.from(items, {
    opacity: 0,
    y: 60,
    stagger: 0.2,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: itemsEl,
    start: "top 85%",
    end: "bottom 65%",
    animation: itemsTl,
    scrub: true,
  });

  // Texto final — blur fade
  const endTl = gsap.timeline({ paused: true });
  endTl.from(endEl, {
    opacity: 0,
    filter: "blur(6px)",
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: endEl,
    start: "top 90%",
    end: "top 50%",
    animation: endTl,
    scrub: true,
  });
</script>
