---
import type { RichTextField } from "@prismicio/client";
import type { HomepageHacemosItem } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";

interface Props {
  label: string;
  title: string;
  subtitle: string;
  items: HomepageHacemosItem[];
  endText: RichTextField;
}

const { label, title, subtitle, items, endText } = Astro.props;
---

<section
  id="hacemos"
  class="relative overflow-hidden px-10 py-24"
  style="background-color: #7A8E96;"
>
  <!-- Large 3c watermark -->
  <div
    class="absolute right-0 top-1/2 -translate-y-1/2 select-none pointer-events-none"
    style="font-family: var(--font-heading);"
    aria-hidden="true"
  >
    <span class="text-[22rem] font-bold italic leading-none text-[#6A7E86]/30">
      3c
    </span>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="space-y-2">
      <p
        class="text-xs tracking-[0.3em] uppercase text-[#1E1816]/60 mb-3 font-light"
      >
        {label}
      </p>
      <p class="text-neutral-900">{title}</p>
      <h3 class="text-3xl text-neutral-900">{subtitle}</h3>
    </div>
    <div class="flex flex-col gap-0 divide-[#6A7E86]/40 max-w-xl pt-14">
      {
        items.map((item) => (
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-3">
              <div class="h-2 w-2 rounded-full bg-white" />
              <h3 class="text-3xl uppercase text-neutral-100 font-bold">
                {item.titulo}
              </h3>
            </div>
            <PrismicRichText
              field={item.description}
              class="[&_p]:leading-relaxed [&_p]:text-neutral-90"
            />
          </div>
        ))
      }
    </div>

    <div class="mt-16">
      <PrismicRichText
        field={endText}
        class="[&_p]:text-3xl [&_p]:font-light [&_p]:text-neutral-50 [&_p]:font-serif [&_p+p]:mt-2 [&_em]:italic"
      />
    </div>
  </div>
</section>
