<section class="flex min-h-[calc(100vh-72px)] bg-[#9A9898]">
  <!-- <div class="w-[60%] bg-[#9A9898] shrink-0"></div> -->

  <div
    class="w-full container mx-auto flex flex-col justify-center px-14 py-20"
  >
    <h1
      class="text-5xl xl:text-6xl font-light italic leading-tight text-[#1E1816]"
      style="font-family: var(--font-heading);"
    >
      Toda transformación<br />
      empieza con<br />
      <em class="not-italic font-semibold">el valor de cruzar.</em>
    </h1>

    <p class="mt-8 text-sm leading-relaxed text-[#4A3E36] max-w-sm font-light">
