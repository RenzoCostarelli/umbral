---
import type { RichTextField, ImageField } from "@prismicio/client";
import PrismicRichText from "./PrismicRichText.astro";

interface Props {
  title: string;
  text: RichTextField;
  backgroundImage: ImageField;
}

const { title, text, backgroundImage } = Astro.props;
---

<section
  class="min-h-[calc(100vh-72px)] flex items-center bg-[#9A9898] relative"
>
  <div class="absolute h-full w-full inset-0">
    <div class="absolute h-full w-full inset-0 bg-[#678894]/50"></div>
    {
      backgroundImage.url && (
        <img
          src={backgroundImage.url}
          alt={backgroundImage.alt ?? ""}
          aria-hidden="true"
          class="w-full h-full object-cover object-center"
        />
      )
    }
  </div>

  <div
    class="w-full h-full max-w-5xl mx-auto flex flex-col items-center justify-center px-14 py-20 relative"
  >
    <h1
      class="text-3xl xl:text-4xl leading-tight font-semibold text-[#1E1816]"
      style="font-family: var(--font-heading);"
    >
      {title}
    </h1>

    <PrismicRichText
      field={text}
      class="mt-8 text-xl text-center leading-relaxed text-[#4A3E36] font-light [&_p+p]:mt-4"
    />

    <a
      href="/#servicios"
      style="box-shadow: rgba(255, 255, 255, 0.55) -1px -1px 0.5px 0px, rgba(255, 255, 255, 0.25) 1px 1px 0.5px 0px;"
      class="mt-10 cursor-pointer overflow-hidden transition-all group px-4 py-2 group text-neutral-100 backdrop-blur-xs font-semibold rounded-full hover:scale-101 duration-500 group bg-linear-to-tl to-neutral-50/10 from-neutral-800/30 bg-transparent relative"
    >
      Conocé nuestros servicios
      <span class="text-base ml-2">→</span>
    </a>
  </div>
</section>
