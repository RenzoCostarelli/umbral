---
import LogoSvg from "./ui/LogoSvg.astro";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Somos", href: "/#somos" },
  { label: "Hacemos", href: "/#hacemos" },
  { label: "Diferenciales", href: "/#diferenciales" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header
  id="main-navbar"
  class="w-full bg-radial bg-[#7ea9c4] sticky top-0 z-50 backdrop-blur-sm transition-transform duration-300"
>
  <div class="absolute w-full h-full inset-0 overflow-hidden">
    <div
      class="absolute w-[50%] h-auto aspect-square bg-[#d3c9c2] -top-25 right-20 blur-3xl"
    >
    </div>
  </div>
  <nav
    class="flex items-center justify-between px-10 py-3 container mx-auto relative"
  >
    <div class="flex items-center">
      <a href="/" class="w-54 text-[#1E1816]">
        <LogoSvg />
      </a>
      <p class="font-serif">Consultora en comunicación, cultura y marca</p>
    </div>

    <div class="items-center gap-8 hidden md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-xs text-[#1E1816] tracking-widest uppercase hover:opacity-60 transition-opacity"
          >
            {item.label}
          </a>
        ))
      }

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/company/umbral"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-[#1E1816] hover:opacity-60 transition-opacity"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  const navbar = document.getElementById("main-navbar");
  const threshold = window.innerHeight * 0.25;
  let lastScrollY = window.scrollY;

  window.addEventListener(
    "scroll",
    () => {
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > lastScrollY;

      if (currentScrollY > threshold && scrollingDown) {
        navbar?.classList.add("-translate-y-full");
      } else if (!scrollingDown) {
        navbar?.classList.remove("-translate-y-full");
      }

      lastScrollY = currentScrollY;
    },
    { passive: true },
  );
</script>
