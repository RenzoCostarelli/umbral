---
import type { HomepageServiciosLine } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";
import SectionTitle from "./ui/SectionTitle.astro";

interface Props {
  label: string;
  title: string;
  lines: HomepageServiciosLine[];
}

const { label, title, lines } = Astro.props;
---

<section
  id="servicios"
  class="px-10 py-24 bg-linear-to-br from-[#e1b7a8] to-[#e7cec1]"
>
  <div class="max-w-6xl mx-auto">
    <div id="servicios-header">
      <SectionTitle label={label} title={title} />
    </div>
    <div class="divide-y divide-[#1E1816]/20 mt-12" id="servicios-accordion">
      {
        lines.map((line, index) => (
          <div class="accordion-item">
            <button
              class="accordion-trigger w-full flex items-start gap-6 py-6 text-left cursor-pointer"
              aria-expanded="false"
            >
              <span class="font-serif font-light text-neutral-700 pt-1 w-6 shrink-0">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="md:text-[1.3125rem] font-medium text-neutral-950 leading-snug font-serif">
                      {line.title}
                    </h3>
                    <p class="text-[1rem] leading-relaxed text-neutral-700 mt-1">
                      {line.description}
                    </p>
                  </div>
                  <svg
                    class="accordion-icon text-amber-900/50 shrink-0 mt-1 select-none w-7 h-7"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </div>
              </div>
            </button>
            <div class="accordion-body overflow-hidden h-0">
              <div class="pl-12 pb-6">
                <PrismicRichText
                  field={line.text}
                  class="[&_p]:text-sm [&_p]:leading-relaxed [&_p]:text-neutral-950/70 [&_em]:italic [&_ul]:mt-3 [&_li]:text-sm [&_li]:text-neutral-950/60 [&_li]:list-disc [&_li]:ml-4 [&_li+li]:mt-1.5 [&_strong]:font-medium [&_strong]:text-neutral-950/80"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div id="servicios-cta" class="mt-16 flex justify-center">
      <a
        href="/#contacto"
        class="inline-flex items-center gap-3 border border-neutral-950 text-neutral-950 text-xs tracking-widest uppercase px-8 py-4 hover:bg-[#1E1816] hover:text-[#E2D9CF] transition-colors rounded-full"
      >
        Contanos tu desafío
        <!-- <span class="text-base">→</span> -->
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  // — Acordeón —
  document.querySelectorAll(".accordion-item").forEach((item) => {
    const trigger =
      item.querySelector<HTMLButtonElement>(".accordion-trigger")!;
    const body = item.querySelector<HTMLElement>(".accordion-body")!;
    const icon = item.querySelector<HTMLElement>(".accordion-icon")!;

    let isOpen = false;

    trigger.addEventListener("click", () => {
      isOpen = !isOpen;
      trigger.setAttribute("aria-expanded", String(isOpen));

      if (isOpen) {
        gsap.set(body, { height: "auto" });
        const fullHeight = body.offsetHeight;
        gsap.fromTo(
          body,
          { height: 0 },
          { height: fullHeight, duration: 0.4, ease: "power2.out" },
        );
        gsap.to(icon, { rotation: -180, duration: 0.3, ease: "power2.out" });
      } else {
        gsap.to(body, { height: 0, duration: 0.35, ease: "power2.inOut" });
        gsap.to(icon, { rotation: 0, duration: 0.3, ease: "power2.inOut" });
      }
    });
  });

  // — Animaciones de entrada —

  // Header: label blur → h2 SplitText blur
  const headerEl = document.getElementById("servicios-header")!;
  const labelEl = headerEl.querySelector("p")!;
  const h2El = headerEl.querySelector("h2")!;

  const split = new SplitText(h2El, { type: "words" });

  const headerTl = gsap.timeline({ paused: true });
  headerTl
    .from(labelEl, { opacity: 0, filter: "blur(6px)", ease: "none" })
    .from(
      split.words,
      { opacity: 0, filter: "blur(8px)", stagger: 0.1, ease: "none" },
      "-=0.4",
    );

  ScrollTrigger.create({
    trigger: headerEl,
    start: "top 85%",
    end: "top 40%",
    animation: headerTl,
    scrub: true,
  });

  // Items del acordeón — opacity + y stagger
  const accordionItems = document.querySelectorAll(
    "#servicios-accordion .accordion-item",
  );
  const accordionEl = document.getElementById("servicios-accordion")!;

  const itemsTl = gsap.timeline({ paused: true });
  itemsTl.from(accordionItems, {
    opacity: 0,
    y: 40,
    stagger: 0.15,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: accordionEl,
    start: "top 85%",
    end: "bottom 75%",
    animation: itemsTl,
    scrub: true,
  });

  // CTA — blur fade
  const ctaEl = document.getElementById("servicios-cta")!;

  const ctaTl = gsap.timeline({ paused: true });
  ctaTl.from(ctaEl, { opacity: 0, filter: "blur(6px)", ease: "none" });

  ScrollTrigger.create({
    trigger: ctaEl,
    start: "top 90%",
    end: "top 60%",
    animation: ctaTl,
    scrub: true,
  });
</script>
