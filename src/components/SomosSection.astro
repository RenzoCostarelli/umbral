---
import type { HomepageSomos } from "../types/homepage.ts";
import { Image } from "astro:assets";
import PrismicRichText from "./PrismicRichText.astro";
import SectionTitle from "./ui/SectionTitle.astro";

interface Props {
  label: HomepageSomos["label"];
  title: HomepageSomos["title"];
  subtitle: HomepageSomos["subtitle"];
  profiles: HomepageSomos["profiles"];
  closing: HomepageSomos["closing"];
}

const { label, title, subtitle, profiles, closing } = Astro.props;
---

<section
  id="somos"
  class="px-10 py-24 bg-linear-to-r from-[#e7beac] to-[#c2d0d7]"
>
  <div class="max-w-6xl mx-auto space-y-12">
    <SectionTitle label={label} title={title} subtitle={subtitle} />
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          profiles.map((profile) => (
            <div class="flex flex-col gap-6 group">
              <p class="text-xl text-neutral-950 font-serif">{profile.title}</p>
              <div class="flex">
                {profile.photo?.url ? (
                  <div class="relative w-32 h-32 shrink-0 perspective-near">
                    <div class="w-32 h-32 transform-3d transition-transform duration-700 group-hover:rotate-y-180 relative">
                      <div class="absolute inset-0 backface-hidden rounded-full overflow-hidden">
                        <Image
                          src={profile.photo.url}
                          alt={profile.photo.alt ?? profile.name}
                          width={192}
                          height={192}
                          class="w-32 h-32 object-cover grayscale-100"
                        />
                      </div>
                      <div class="absolute inset-0 backface-hidden rotate-y-180 rounded-full bg-amber-300 flex items-center justify-center">
                        <span class="text-neutral-950 font-serif text-sm font-semibold tracking-wide">WSP</span>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="w-32 h-32 rounded-full bg-[#7A7A7A] shrink-0" />
                )}
                <div class="ml-6 flex flex-col gap-1 font-serif">
                  <h3 class="text-xl text-neutral-950 font-semibold">
                    {profile.name}
                  </h3>

                  {profile.position && (
                    <p class="text-xs text-neutral-950">{profile.position}</p>
                  )}

                  {profile.phone && (
                    <a
                      href={`https://wa.me/${profile.phone.replace(/\D/g, "")}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs  text-neutral-950 font-light hover:text-[#1E1816] transition-colors"
                    >
                      WhatsApp {profile.phone}
                    </a>
                  )}
                </div>
              </div>
              <PrismicRichText
                field={profile.text}
                class="text-sm text-neutral-950 font-serif text-pretty md:pr-12"
              />
            </div>
          ))
        }
      </div>
    </div>

    {
      closing?.length > 0 && (
        <div class="mt-20 pt-12 ">
          <PrismicRichText
            field={closing}
            class="text-2xl font-light font-serif text-[#1E1816]"
          />
        </div>
      )
    }
  </div>
</section>
