---
import type { HomepageSomos } from "../types/homepage.ts";
import { Image } from "astro:assets";
import PrismicRichText from "./PrismicRichText.astro";
import SectionTitle from "./ui/SectionTitle.astro";
import WhatsAppIcon from "./ui/icons/WhatsAppIcon.astro";

interface Props {
  label: HomepageSomos["label"];
  title: HomepageSomos["title"];
  subtitle: HomepageSomos["subtitle"];
  profiles: HomepageSomos["profiles"];
  closing: HomepageSomos["closing"];
}

const { label, title, subtitle, profiles, closing } = Astro.props;

const whatsappMessage =
  "¡Hola! 👋 Gracias por contactarte con Umbral. Nos interesa conocerte y abrir una primera conversación. En breve nos ponemos en contacto con vos para empezar a pensar juntos.";
---

<section
  id="somos"
  class="px-10 py-24 bg-linear-to-r from-[#e7beac] to-[#c2d0d7]"
>
  <div class="max-w-6xl mx-auto space-y-12">
    <div id="somos-header">
      <SectionTitle label={label} title={title} subtitle={subtitle} />
    </div>
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          profiles.map((profile) => (
            <div class="somos-profile flex flex-col gap-6 group">
              <p class="md:text-[1.3125rem] text-neutral-950 font-serif">
                {profile.title}
              </p>
              <div class="flex items-center">
                {profile.photo?.url ? (
                  <div class="relative w-32 h-32 shrink-0 perspective-near">
                    <div class="w-32 h-32 transform-3d transition-transform duration-700 hover:rotate-y-180 relative cursor-pointer">
                      <div class="absolute inset-0 backface-hidden rounded-full overflow-hidden">
                        <Image
                          src={profile.photo.url}
                          alt={profile.photo.alt ?? profile.name}
                          width={192}
                          height={192}
                          class="w-32 h-32 object-cover grayscale-100"
                        />
                      </div>
                      {profile.phone ? (
                        <a
                          href={`https://wa.me/${profile.phone.replace(/\D/g, "")}?text=${encodeURIComponent(whatsappMessage)}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="Contactar por WhatsApp"
                          class="absolute inset-0 backface-hidden rotate-y-180 rounded-full bg-linear-to-br from-neutral-50 to-neutral-300 flex items-center justify-center"
                        >
                          <WhatsAppIcon
                            phone={profile.phone}
                            iconOnly
                            class="w-10 h-10 text-neutral-950"
                          />
                        </a>
                      ) : (
                        <div class="absolute inset-0 backface-hidden rotate-y-180 rounded-full bg-linear-to-br from-neutral-50 to-neutral-300 flex items-center justify-center" />
                      )}
                    </div>
                  </div>
                ) : (
                  <div class="w-32 h-32 rounded-full bg-[#7A7A7A] shrink-0" />
                )}
                <div class="ml-6 flex flex-col gap-1 font-serif">
                  <h3 class="text-xl text-neutral-950 font-semibold">
                    {profile.name}
                  </h3>

                  {profile.position && (
                    <p class="text-xs text-neutral-950">{profile.position}</p>
                  )}

                  {profile.phone && (
                    <a
                      href={`https://wa.me/${profile.phone.replace(/\D/g, "")}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs  text-neutral-950 font-light hover:text-[#1E1816] transition-colors"
                    >
                      WhatsApp {profile.phone}
                    </a>
                  )}
                </div>
              </div>

              <PrismicRichText
                field={profile.text}
                class="text-sm text-neutral-950 font-serif text-pretty md:pr-12"
              />
            </div>
          ))
        }
      </div>
      <div class="flex w-full" id="somos-cta-button">
        <a
          href="/manifiesto"
          class="mt-15 mx-auto inline-flex items-center gap-3 border border-neutral-50 text-neutral-950 text-xs tracking-widest uppercase px-8 py-4 hover:bg-neutral-50 hover:text-neutral-950 transition-colors rounded-full"
        >
          Manifiesto
        </a>
      </div>
      {
        closing?.length > 0 && (
          <div id="somos-closing" class="mt-10 ">
            <PrismicRichText
              field={closing}
              class="md:text-[1.3125rem] font-light font-serif text-[#1E1816]"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  const headerEl = document.getElementById("somos-header")!;
  const paragraphs = Array.from(
    headerEl.querySelectorAll("p"),
  ) as HTMLElement[];
  const labelEl = paragraphs[0];
  const subtitleEl = paragraphs[1] ?? null;
  const h2El = headerEl.querySelector("h2") as HTMLElement;

  const split = new SplitText(h2El, { type: "words" });

  const headerTl = gsap.timeline({ paused: true });
  headerTl
    .from(labelEl, { opacity: 0, filter: "blur(6px)", ease: "none" })
    .from(
      split.words,
      { opacity: 0, filter: "blur(8px)", stagger: 0.1, ease: "none" },
      "-=0.4",
    );

  if (subtitleEl) {
    headerTl.from(
      subtitleEl,
      { opacity: 0, filter: "blur(6px)", ease: "none" },
      "-=0.3",
    );
  }

  ScrollTrigger.create({
    trigger: headerEl,
    start: "top 85%",
    end: "top 40%",
    animation: headerTl,
    scrub: true,
  });

  // — Perfiles — el primero entra desde la izquierda, el segundo desde la derecha
  const profiles = document.querySelectorAll(".somos-profile");
  const profilesGrid = profiles[0]?.parentElement;

  const profilesTl = gsap.timeline({ paused: true });
  if (profiles[0]) {
    profilesTl.from(profiles[0], { opacity: 0, x: -80, ease: "none" }, 0);
  }
  if (profiles[1]) {
    profilesTl.from(profiles[1], { opacity: 0, x: 80, ease: "none" }, 0);
  }

  ScrollTrigger.create({
    trigger: profilesGrid ?? "#somos",
    start: "top 80%",
    end: "center 65%",
    animation: profilesTl,
    scrub: true,
  });

  const ctaButtonEl = document.getElementById("somos-cta-button");

  if (ctaButtonEl) {
    const ctaTl = gsap.timeline({ paused: true });
    ctaTl.from(ctaButtonEl, {
      opacity: 0,
      y: 30,
      ease: "none",
    });

    ScrollTrigger.create({
      trigger: ctaButtonEl,
      start: "top 90%",
      end: "top 70%",
      animation: ctaTl,
      scrub: true,
    });
  }

  // — Closing —
  const closingEl = document.getElementById("somos-closing");

  if (closingEl) {
    const closingTl = gsap.timeline({ paused: true });
    closingTl.from(closingEl, {
      opacity: 0,
      filter: "blur(6px)",
      ease: "none",
    });

    ScrollTrigger.create({
      trigger: closingEl,
      start: "top 90%",
      end: "top 80%",
      animation: closingTl,
      scrub: true,
    });
  }
</script>
