---
import type { RichTextField } from "@prismicio/client";
import type { HomepageTeSuenaCard } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";
import TresIcon from "./ui/icons/tresIcon.astro";

interface Props {
  title: string;
  cards: HomepageTeSuenaCard[];
  endPhrase1: RichTextField;
  endPhrase2: RichTextField;
}

const { title, cards, endPhrase1, endPhrase2 } = Astro.props;
---

<section
  id="somos"
  class="px-10 py-24 bg-linear-to-r from-[#72737f] to-[#b6947b] relative overflow-hidden"
>
  <div class="absolute w-80 right-0 top-10 text-neutral-50 opacity-10">
    <TresIcon />
  </div>
  <div
    class="absolute -right-60 -bottom-60 bg-[#72737f]/80 w-120 h-120 rounded-full blur-3xl"
  >
  </div>
  <div class="max-w-6xl mx-auto">
    <h2
      id="te-suena-title"
      class="text-3xl xl:text-4xl text-neutral-800 mb-10 font-serif"
    >
      {title}
    </h2>

    <div
      id="te-suena-cards"
      class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-8"
    >
      {
        cards.map((card, index) => (
          <div class="te-suena-card bg-[#cdad9a] pb-5 pt-5 px-8 flex flex-col gap-6 rounded-3xl">
            <div class="text-5xl text-neutral-50 font-serif flex items-center gap-2">
              <div class="text-4xl">{index + 1}</div>
              <div class="h-2 w-2 rounded-full bg-white" />
            </div>
            <div class="font-serif">
              <div class="text-2xl text-neutral-50">{card.titleLine1}</div>
              <div class="text-2xl italic">{card.titleLine2}</div>
            </div>
            <PrismicRichText
              field={card.text}
              class="leading-relaxed text-neutral-900 font-light"
            />
          </div>
        ))
      }
    </div>

    <div class="border-t border-[#A08878]/30 pt-10">
      {
        endPhrase1.length > 0 && (
          <PrismicRichText
            field={endPhrase1}
            class="[&_p]:text-xl [&_p]:md:text-2xl [&_p]:font-light [&_p]:font-serif"
          />
        )
      }
      {
        endPhrase2.length > 0 && (
          <PrismicRichText
            field={endPhrase2}
            class="[&_p]:text-xl [&_p]:md:text-3xl [&_p]:italic [&_p]:text-neutral-50 [&_p]:font-light [&_p]:font-serif"
          />
        )
      }
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../lib/gsap";

  const titleEl = document.getElementById("te-suena-title")!;
  const cards = document.querySelectorAll(".te-suena-card");

  // Title — blur animation on scroll
  const split = new SplitText(titleEl, { type: "words" });

  const titleTl = gsap.timeline({ paused: true });
  titleTl.from(split.words, {
    opacity: 0,
    filter: "blur(8px)",
    stagger: 0.1,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: titleEl,
    start: "top 85%",
    end: "top 45%",
    animation: titleTl,
    scrub: true,
  });

  // Cards — opacity + translateY con stagger en scroll
  const cardsTl = gsap.timeline({ paused: true });
  cardsTl.from(cards, {
    opacity: 0,
    y: 60,
    stagger: 0.2,
    ease: "none",
  });

  ScrollTrigger.create({
    trigger: "#te-suena-cards",
    start: "top 85%",
    end: "bottom 65%",
    animation: cardsTl,
    scrub: true,
  });
</script>
