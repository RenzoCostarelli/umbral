---
import type { RichTextField } from "@prismicio/client";
import type { HomepageTeSuenaCard } from "../types/homepage.ts";
import PrismicRichText from "./PrismicRichText.astro";

interface Props {
  title: string;
  cards: HomepageTeSuenaCard[];
  endPhrase1: RichTextField;
  endPhrase2: RichTextField;
}

const { title, cards, endPhrase1, endPhrase2 } = Astro.props;
---

<section
  id="somos"
  class="px-10 py-24"
  style="background: linear-gradient(135deg, #4E4248 0%, #6E5E5A 50%, #887870 100%);"
>
  <div class="max-w-6xl mx-auto">
    <h2
      class="text-6xl xl:text-7xl font-light italic text-[#E2D9CF] mb-16"
      style="font-family: var(--font-heading);"
    >
      {title}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      {
        cards.map((card, index) => (
          <div class="border border-[#b3a19a] bg-[#b3a19a] pb-14 pt-8 px-8 flex flex-col gap-6 rounded-3xl">
            <div class="text-5xl text-neutral-50 font-serif flex items-center gap-2">
              <div class="text-6xl">{index + 1}</div>
              <div class="h-2 w-2 rounded-full bg-white" />
            </div>
            <div class="font-serif">
              <div class="text-3xl text-neutral-50">{card.titleLine1}</div>
              <div class="text-3xl italic">{card.titleLine2}</div>
            </div>
            <PrismicRichText
              field={card.text}
              class="leading-relaxed text-neutral-900 font-light"
            />
          </div>
        ))
      }
    </div>

    <div class="border-t border-[#A08878]/30 pt-10">
      {
        endPhrase1.length > 0 && (
          <PrismicRichText
            field={endPhrase1}
            class="[&_p]:text-xl [&_p]:md:text-3xl [&_p]:font-light [&_p]:font-serif"
          />
        )
      }
      {
        endPhrase2.length > 0 && (
          <PrismicRichText
            field={endPhrase2}
            class="[&_p]:text-xl [&_p]:md:text-3xl [&_p]:italic [&_p]:text-neutral-50 [&_p]:font-light [&_p]:font-serif"
          />
        )
      }
    </div>
  </div>
</section>
