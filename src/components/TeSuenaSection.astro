---
const signals = [
  {
    number: "1",
    tag: "Creciste.",
    title: "¿Tu comunicación también?",
    text: "Cada área terminó hablando su propio idioma.",
  },
  {
    number: "2",
    tag: "¿La cultura que declarás",
    title: "es la que se vive?",
    text: "Lo que se dice puertas afuera y lo que pasa puertas adentro no siempre coinciden.",
  },
  {
    number: "3",
    tag: "Buenos equipos,",
    title: "conversaciones postergadas",
    text: "Las decisiones clave pierden impulso cuando nadie las nombra.",
  },
];
---

<section
  id="somos"
  class="px-10 py-24"
  style="background: linear-gradient(135deg, #4E4248 0%, #6E5E5A 50%, #887870 100%);"
>
  <div class="max-w-6xl mx-auto">
    <h2
      class="text-6xl xl:text-7xl font-light italic text-[#E2D9CF] mb-16"
      style="font-family: var(--font-heading);"
    >
      ¿Te suena?
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      {
        signals.map((signal) => (
          <div class="border border-[#b3a19a] bg-[#b3a19a] pb-14 pt-8 px-8 flex flex-col gap-6 rounded-3xl">
            <div class="text-5xl text-neutral-50 font-serif flex items-center gap-2">
              <div class="text-6xl">{signal.number}</div>

              <div class="h-2 w-2 rounded-full bg-white" />
            </div>
            <div class="font-serif">
              <div class="text-3xl text-neutral-50">{signal.tag}</div>
              <div class="text-3xl italic">{signal.title}</div>
            </div>

            <p class="eading-relaxed text-neutral-900 font-light">
              {signal.text}
            </p>
          </div>
        ))
      }
    </div>

    <div class="border-t border-[#A08878]/30 pt-10">
      <p class="text-xl md:text-3xl font-light font-serif">
        Si reconociste alguna de estas señales, tu organización está frente a un
        umbral.
      </p>
      <p
        class="text-xl md:text-3xl italic text-neutral-50 font-light font-serif"
      >
        Nosotras ayudamos a cruzarlo.
      </p>
    </div>
  </div>
</section>
