---
const { label, title, subtitle } = Astro.props;
---

<div class="space-y-2">
  <p class="text-xs tracking-[0.3em] uppercase text-neutral-950">
    {label}
  </p>
  <h2
    class="text-xl xl:text-2xl font-semibold text-neutral-950"
    style="font-family: var(--font-heading);"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-sm text-neutral-950/ leading-relaxed">{subtitle}</p>
    )
  }
</div>
