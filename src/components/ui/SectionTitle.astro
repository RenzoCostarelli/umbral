---
const { label, title, subtitle } = Astro.props;
---

<div class="space-y-2">
  <p class="text-xs tracking-[0.3em] uppercase text-neutral-950">
    {label}
  </p>
  <h2
    class="text-xl md:text-[1.3125rem] font-semibold text-neutral-950 font-serif"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-[1.25rem] text-neutral-950/ leading-relaxed">{subtitle}</p>
    )
  }
</div>
