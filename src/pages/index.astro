---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import HeroSection from "../components/HeroSection.astro";
import TeSuenaSection from "../components/TeSuenaSection.astro";
import HacemosSection from "../components/HacemosSection.astro";
import ServiciosSection from "../components/ServiciosSection.astro";
import DiferencialesSection from "../components/DiferencialesSection.astro";
import SomosSection from "../components/SomosSection.astro";
import ContactoSection from "../components/ContactoSection.astro";
import { getHomepage } from "../lib/getHomepage.ts";

const homepage = await getHomepage();
---

<Layout title="Umbral — Consultora en comunicación, cultura y marca23">
  <Navbar />
  <main>
    <HeroSection
      title={homepage.hero.title}
      text={homepage.hero.text}
      backgroundImage={homepage.hero.backgroundImage}
    />
    <TeSuenaSection
      title={homepage.tesuena.title}
      cards={homepage.tesuena.cards}
      endPhrase1={homepage.tesuena.endPhrase1}
      endPhrase2={homepage.tesuena.endPhrase2}
    />
    <HacemosSection
      label={homepage.hacemos.label}
      title={homepage.hacemos.title}
      subtitle={homepage.hacemos.subtitle}
      items={homepage.hacemos.items}
      endText={homepage.hacemos.endText}
    />
    <ServiciosSection
      label={homepage.servicios.label}
      title={homepage.servicios.title}
      lines={homepage.servicios.lines}
    />
    <!-- <DiferencialesSection />
    <SomosSection /> -->
    <ContactoSection />
  </main>
  <Footer />
</Layout>
