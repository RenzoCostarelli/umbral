---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PrismicRichText from "../../components/PrismicRichText.astro";
import { getManifiesto } from "../../lib/getManifiesto.ts";
import LogoSvg from "../../components/ui/LogoSvg.astro";

const manifiesto = await getManifiesto();
---

<Layout title="Manifiesto — Umbral">
  <Navbar />
  <main>
    <section
      class="px-6 md:px-16 pt-14 pb-40 bg-linear-to-tr from-[#538393] to-[#ac8f82]"
    >
      <div class="container mx-auto">
        <div
          id="manifiesto-content"
          class="max-w-4xl mx-auto bg-white/50 p-10 rounded-2xl"
        >
          <PrismicRichText
            field={manifiesto.text}
            class="font-serif font-light text-neutral-800 text-balance
              [&_h1]:text-5xl [&_h1]:font-light [&_h1]:leading-tight [&_h1]:mb-8
              [&_h2]:text-4xl [&_h2]:font-normal [&_h2]:leading-snug [&_h2]:mt-14 [&_h2]:mb-6
              [&_h3]:text-3xl [&_h3]:font-normal [&_h3]:mt-10 [&_h3]:mb-4
              [&_h4]:text-sm [&_h4]:uppercase [&_h4]:tracking-widest [&_h4]:font-semibold [&_h4]:mt-8 [&_h4]:mb-3
              [&_h5]:text-sm [&_h5]:uppercase [&_h5]:tracking-widest [&_h5]:font-semibold [&_h5]:mt-8 [&_h5]:mb-3
              [&_h6]:text-sm [&_h6]:uppercase [&_h6]:tracking-widest [&_h6]:font-semibold [&_h6]:mt-8 [&_h6]:mb-3
              [&_p]:text-xl [&_p]:mb-3
              [&_strong]:font-semibold
              [&_em]:italic
              [&_a]:underline [&_a]:underline-offset-4 [&_a]:transition-opacity [&_a]:hover:opacity-70
              [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-6
              [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-6
              [&_li]:text-xl [&_li]:leading-[1.85] [&_li]:mb-2
              [&_pre]:text-sm [&_pre]:bg-white/5 [&_pre]:border [&_pre]:border-white/10 [&_pre]:rounded [&_pre]:p-5 [&_pre]:mb-6 [&_pre]:overflow-x-auto"
          />
          <div class="w-50 mt-12 -ml-5">
            <LogoSvg />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { gsap, ScrollTrigger } from "../../lib/gsap";

  const contentEl = document.getElementById("manifiesto-content")!;

  const mm = gsap.matchMedia();

  mm.add("(min-width: 768px)", () => {
    const blocks = Array.from(
      contentEl.querySelectorAll("h1, h2, h3, h4, h5, h6, p, ul, ol, pre"),
    ) as HTMLElement[];

    const contentTl = gsap.timeline({ paused: true });
    contentTl.from(blocks, {
      opacity: 0.25,
      filter: "blur(2px)",
      stagger: 0.12,
      ease: "none",
    });

    ScrollTrigger.create({
      trigger: contentEl,
      start: "top 80%",
      end: "bottom 70%",
      animation: contentTl,
      scrub: true,
    });
  });
</script>
